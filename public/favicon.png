<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="none">
  <defs>
    <linearGradient id="cyanGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#22d3ee"/>
      <stop offset="100%" stop-color="#0284c7"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="8" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>

  <!-- Background rounded card for ultra visibility -->
  <rect width="512" height="512" rx="128" fill="#020617"/>
  <rect width="512" height="512" rx="128" fill="none" stroke="#1e293b" stroke-width="8"/>

  <!-- P Emblem Group -->
  <g transform="translate(110, 80)">
    <!-- Main Stylized P Body -->
    <path d="M 40,30 L 160,30 C 235,30 280,65 280,135 C 280,205 235,240 160,240 L 110,240 L 110,380 L 60,380 L 60,90 L 40,90 Z" 
          fill="url(#cyanGrad)" filter="url(#glow)"/>
    
    <!-- P Inner Loop Cutout -->
    <path d="M 110,80 L 160,80 C 195,80 220,95 220,135 C 220,175 195,190 160,190 L 110,190 Z" fill="#020617"/>
    
    <!-- >_ Terminal Prompt inside P -->
    <path d="M 125,100 L 155,125 L 125,150" stroke="#38bdf8" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    <line x1="170" y1="150" x2="200" y2="150" stroke="#38bdf8" stroke-width="16" stroke-linecap="round"/>

    <!-- Bottom Angled Cyber Tail Accent -->
    <path d="M 60,330 L 20,380 L 110,380" fill="#38bdf8" opacity="0.95"/>
  </g>
</svg>
